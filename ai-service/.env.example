# Copy this file to .env when you need to override local defaults.
AI_SERVICE_APP_NAME="Lumen AI Service"
AI_SERVICE_ENVIRONMENT="development"
AI_SERVICE_JOBS_DATABASE_PATH="ai_jobs.db"
AI_SERVICE_WORKER_POLL_INTERVAL_SECONDS="0.2"
AI_SERVICE_FAKE_GENERATION_DELAY_SECONDS="0.15"
# Must match AI_SERVICE_INTERNAL_API_KEY in the Next.js .env file.
AI_SERVICE_INTERNAL_API_KEY="replace-with-a-long-random-service-secret"

# Set to "true" to use real Qwen model via Ollama (local, no API key needed).
# When "false", the service uses FakeModuleGenerator.
AI_SERVICE_USE_REAL_MODULE_GENERATOR="true"

# Qwen Model Configuration (Local via Ollama - NO API KEY NEEDED)
# Make sure Ollama is running: ollama serve
# Pull the model first: ollama pull qwen3.6:27b
AI_SERVICE_QWEN_MODEL="qwen3.6:27b"
AI_SERVICE_QWEN_REQUEST_TIMEOUT_SECONDS="120"

# Reference file ingestion settings.
AI_SERVICE_REFERENCE_STORAGE_PATH="reference_files"
AI_SERVICE_REFERENCE_MAX_FILE_SIZE_BYTES="26214400"
AI_SERVICE_REFERENCE_MIN_IMAGE_DIMENSION="100"

# Web Search settings (DuckDuckGo - no API key needed)
AI_SERVICE_WEB_SEARCH_ENABLED="true"
AI_SERVICE_WEB_SEARCH_MAX_RESULTS="5"

# Embedding settings (local models)
AI_SERVICE_EMBEDDING_TEXT_MODEL="intfloat/multilingual-e5-small"
AI_SERVICE_EMBEDDING_IMAGE_MODEL="sentence-transformers/clip-ViT-B-32"
AI_SERVICE_EMBEDDING_BATCH_SIZE="32"
